# Real secrets — never commit. See SECRETS.md.
firmware/main/secrets.h
pc_service/.env
pc_service/config.local.*

# ESP-IDF build output
firmware/build/
firmware/managed_components/
firmware/dependencies.lock

# Python
__pycache__/
*.pyc
pc_service/.venv/

# Logs and scratch output. Nothing in this project writes into the repo by
# design -- session logs and serial captures belong outside it -- but a stray
# capture is easy to make and easy to commit by accident, and a serial log can
# quietly contain a real LAN address. See SECRETS.md.
*.log
*.tmp
soak/

# Local machine config — not secret, but machine-specific (absolute toolchain
# paths, local username, COM port) and useless to anyone else.
firmware/.vscode/

# Machine-generated build config. The settings that matter live in
# sdkconfig.defaults, which IS committed. Note "regenerated" means regenerated
# when ABSENT: an existing sdkconfig takes precedence over sdkconfig.defaults,
# so after pulling a change to that file you have to delete this one (or use
# menuconfig) for the change to take effect. See the note in sdkconfig.defaults.
firmware/sdkconfig
firmware/sdkconfig.old
