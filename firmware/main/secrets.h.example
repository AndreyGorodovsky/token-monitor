/* Copy this file to `secrets.h` in the same folder and fill in your real
 * values. `secrets.h` is gitignored; this `.example` is the committed
 * template. See ../../SECRETS.md for the convention and why it matters.
 *
 *   Windows:  copy secrets.h.example secrets.h
 *   Linux:    cp secrets.h.example secrets.h
 *
 * Nothing in this file is a Claude credential -- the OAuth token never
 * reaches the chip. This is WiFi plus the LAN address of pc_service only.
 */
#pragma once

/* Your 2.4 GHz WiFi network. The ESP32-C3 has no 5 GHz radio, so if your
 * router broadcasts both bands under one name and this fails to connect,
 * that is the first thing to check. */
#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

/* LAN address of the machine running pc_service. Find it with `ipconfig`
 * (Windows) or `ip addr` (Linux) on that machine. It is DHCP-assigned on
 * most home networks, so it can change -- a router DHCP reservation makes
 * it permanent. Not used until firmware stage 5. */
#define PC_SERVICE_HOST "192.168.1.50"
#define PC_SERVICE_PORT 8734
