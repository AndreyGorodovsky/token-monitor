# Checked-in build config. `sdkconfig` itself is machine-generated (and gets
# regenerated by a fullclean), so anything that must survive a fresh clone or
# a config reset belongs here, not there.

# The XIAO ESP32-C3 has 4 MB of flash. IDF's default is 2 MB, which makes the
# bootloader log:
#   W spi_flash: Detected size(4096k) larger than the size in the binary
#   image header(2048k). Using the size in the binary image header.
# and quietly strands half the chip's flash. Harmless while the app is small,
# but there is no reason to leave it wrong.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Give the app 1.5 MB instead of the default 1 MB.
#
# IDF's default single-app table leaves a 0x100000 factory partition, and by
# the end of stage 8 plus the gauge arcs only about 68 KB of that was free.
# SoftAP provisioning adds esp_http_server, AP-mode support and an HTML page
# on top of that -- probably a fit, but "probably" is a bad thing to find out
# halfway through writing a feature. This raises the partition to 0x180000.
#
# There is no cost: the chip has 4 MB of flash and the rest was simply unused.
# Note that changing the table moves where the app lives, so the table itself
# has to be rewritten on the next flash -- `idf.py flash` does that; flashing
# the app alone would leave a mismatch.
#
# IMPORTANT, and not obvious: this file supplies DEFAULTS. kconfgen applies it
# underneath an existing `sdkconfig`, which wins. So on a tree that has already
# been built once, this line changes nothing at all and does so silently -- you
# keep the 1 MB partition. Delete `firmware/sdkconfig` (it is gitignored and
# regenerated) or set the option in `idf.py menuconfig`. The symptom of missing
# this is not an error here; it is a puzzling "app partition is too small" at
# link time later, once the firmware has grown into the space this was meant to
# provide.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Let a phone's request headers through to the setup form.
#
# esp_http_server buffers the whole header block of a request in one scratch
# buffer, and IDF's default size for it is 512 bytes. That is enough for the
# initial GET of the form and NOT enough for the POST that submits it: a
# mobile browser adds Content-Type, Content-Length, Origin, Referer and the
# sec-ch-* set on a form submission, which pushes the block past 512. The
# server then answers 431 and the handler never runs at all -- so the failure
# looks like the form being ignored rather than like a size limit.
#
# Found on hardware at provisioning stage 3: the GET was served, the POST was
# refused. 2048 leaves comfortable margin over the ~900 bytes measured, and
# costs one 2 KB buffer per server instance (it lives in httpd_data, not per
# connection) out of ~190 KB free heap.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
